# Claude / AI assistant context — local only, never track
CLAUDE.md
.claude/
.cursor/
.aider*

# Planning / design docs — local only. Spec-mandated docs are negated below.
# Note: this must exclude docs/* (the directory contents), not docs/ (the
# directory). Git cannot re-include a file whose parent directory is excluded,
# so "docs/" would make the negations below dead letters.
docs/*
!docs/api.md
!docs/providers.md
*.design.md
*.implementation.md

# Security scan output
scans/

# Build output
/dist/
/bin/
/build/
/blessedbot

# Go
*.exe
*.exe~
*.test
*.out
coverage.*
profile.cov
go.work
go.work.sum
vendor/

# Frontend
web/node_modules/
web/dist/
web/.vite/
# TypeScript incremental build state and Vitest coverage output.
web/*.tsbuildinfo
web/coverage/
*.log
npm-debug.log*

# Frontend build output is embedded from here; keep the tracked placeholder.
# Built frontend: only the placeholder marker is tracked, so `go:embed all:dist`
# compiles on a fresh clone. A committed index.html would point at hashed asset
# files that are ignored, which is worse than no index at all.
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# Local dev config / data
.env
.env.*
!.env.example
/data/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
config.yaml

# Python (legacy leftovers)
__pycache__/
*.py[cod]

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
